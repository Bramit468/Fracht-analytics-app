# Tikras reiksmes deti i .env.local, kuris NEEINA i git.
#
# Be NEXT_PUBLIC_ priesagos reiksme lieka serveryje. Su ja Next.js ideda ja
# tiesiai i narsykles koda, tad taip zymimi tik vieni matomi raktai.

# Supabase (#2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Telematika.lt (#44). Nuorodose yra prieigos raktas, todel jos serverio pusej.
# Tas pacias reiksmes reikia ideti ir i Vercel: Settings -> Environment Variables.
TELEMATIKA_CANDAILY_URL=
TELEMATIKA_SUPPLIES_URL=

# PTV Developer (#61): vilkiko marsrutas ir keliu mokesciai is adresu.
# Be sio rakto forma veikia kaip anksciau, tik mygtukas nerodomas.
# Nemokamas lygis: 100 000 uzklausu per menesi. https://developer.myptv.com
PTV_API_KEY=
